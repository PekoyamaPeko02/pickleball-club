{
  "name": "pickleball-club",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @pbc/web dev",
    "dev:admin": "pnpm --filter @pbc/admin dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "db:up": "docker compose up -d db",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "api": "dotnet run --project backend/src/PickleballClub.Api",
    "demo:data": "node scripts/demo-data.mjs",
    "e2e": "pnpm --filter @pbc/e2e test"
  },
  "engines": {
    "node": ">=22"
  }
}
