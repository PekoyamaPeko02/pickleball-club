    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "typescript": "~5.9.3",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": "^22 || ^24",
    "pnpm": ">= 9"
